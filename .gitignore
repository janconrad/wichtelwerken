# Standard: Nur eigenes Theme und Dokumentation versionieren.
*

!.gitignore
!README.md
!.github/
!.github/**
!bin/
!bin/**
!.ddev/
!.ddev/config.yaml
!.ddev/nginx_full/
!.ddev/nginx_full/nginx-site.conf
!docs/
!docs/**
!wp-content/
!wp-content/.htaccess
!wp-content/mu-plugins/
!wp-content/mu-plugins/wichtelwerken-privacy.php
!wp-content/mu-plugins/wichtelwerken-performance-monitoring.php
!wp-content/mu-plugins/wichtelwerken-production-hardening.php
!wp-content/themes/
!wp-content/themes/wichtelwerken-child/
!wp-content/themes/wichtelwerken-child/**
!wp-content/uploads/
